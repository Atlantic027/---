{
  "name": "max35-teacher-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MAX35 portable teacher candidate with offline handwriting model",
  "author": "MAX35 Classroom",
  "main": "main/main.cjs",
  "scripts": {
    "prepare:backend": "node scripts/prepare.cjs",
    "build:helper": "node scripts/build-helper.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "build": "npm run prepare:backend && npm run build:helper && npm test && electron-builder --win portable --x64 && npm run audit:package",
    "audit:package": "node scripts/audit-package.cjs",
    "verify:exe": "node scripts/verify-exe.cjs"
  },
  "dependencies": { "express": "4.21.2", "multer": "1.4.5-lts.2", "ws": "8.18.3" },
  "devDependencies": { "electron": "44.5.1", "electron-builder": "26.15.3", "@noble/hashes": "1.7.2" },
  "build": {
    "appId": "org.max35.teacher",
    "productName": "MAX35 Teacher",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main/**", "preload/**", "network/*.cjs", "ui/**", "backend/**", "package.json"],
    "extraResources": [{ "from": "network/bin/WlanHelper.exe", "to": "network/WlanHelper.exe" }, { "from": "resources/handwriting", "to": "handwriting", "filter": ["**/*"] }],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "MAX35-Teacher-${version}-with-model-${arch}.${ext}", "requestExecutionLevel": "user" }
  }
}
